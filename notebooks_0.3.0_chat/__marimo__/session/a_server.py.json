          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"section-7-sse-helpers\">Section 7: SSE helpers</h1>\n<span class=\"paragraph\">A <code>Changes</code> object: subscribers wait on it; producers <code>notify_all()</code> to wake them. Built on threading.Condition \u2014 no asyncio bridge needed because everything is threaded.</span></span>"
          }
        }
      ],
